# cp .env.example .env   (then edit; .env is git-ignored). A variable already set in the shell wins over this file.
# The dictionary: the folder of entry files (*.jsonl), or one file (several: `:`-separated).
NOM_ALIGN_TABLE=/path/to/lexicon/entries
# NOM_ALIGN_OUT_DIR=out
# Characters that no table lists are looked up online once and cached. NOM_ALIGN_OFFLINE=1 turns that off.
# NOM_ALIGN_OFFLINE=1
# NOM_ALIGN_CACHE=~/.cache/ocr-nom-align/online_readings.json
# Your email or a URL, put in the User-Agent of the online lookup so the site can reach you.
# NOM_ALIGN_CONTACT=you@example.org
